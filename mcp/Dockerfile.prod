# mcp/Dockerfile.prod
# syntax=docker/dockerfile:1.11
# Production Dockerfile for Kidney-Genetics-DB MCP Server
# Based on uv best practices: https://docs.astral.sh/uv/guides/integration/docker/

# ============================================================================
# STAGE 1: Build dependencies
# ============================================================================
FROM python:3.13-slim-bookworm@sha256:93498f36dc7e24ef233bfdf6cc17d4b8bd32d94ee737143e906460d5f5a914c5 AS builder

# Install uv - pinned by version and digest for reproducible builds (Dependabot bumps both)
COPY --from=ghcr.io/astral-sh/uv:0.11.28@sha256:0f36cb9361a3346885ca3677e3767016687b5a170c1a6b88465ec14aefec90aa /uv /uvx /bin/

WORKDIR /app

# Phase 1: Install dependencies only (better layer caching)
# This layer is cached when only code changes, not dependencies
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    uv sync --frozen --no-install-project --no-dev

# Copy application source and lock file
COPY src ./src
COPY pyproject.toml uv.lock ./

# Phase 2: Install project (runs when code changes)
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev

# ============================================================================
# STAGE 2: Production runtime
# ============================================================================
FROM python:3.13-slim-bookworm@sha256:93498f36dc7e24ef233bfdf6cc17d4b8bd32d94ee737143e906460d5f5a914c5 AS production

# OCI standard labels
LABEL org.opencontainers.image.title="Kidney-Genetics-DB MCP Server" \
      org.opencontainers.image.description="Read-only MCP server exposing Kidney-Genetics-DB public data to LLMs" \
      org.opencontainers.image.vendor="Kidney-Genetics Database" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.source="https://github.com/berntpopp/kidney-genetics-db"

# Install runtime dependencies and apply security updates
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && \
    apt-get upgrade -y && \
    apt-get install -y --no-install-recommends \
        curl \
    && rm -rf /var/lib/apt/lists/* \
    && rm -rf /root/.cache \
    # Security: Remove setuid/setgid bits
    && find /usr -perm /6000 -type f -exec chmod a-s {} \; 2>/dev/null || true

# Security: remove the base image's pip (unused at runtime; its vendored urllib3/msgpack/setuptools
# carry CVEs) as backend/Dockerfile does, then create the non-root user (UID 10001 avoids host conflicts)
RUN pip uninstall -y pip setuptools 2>/dev/null || true && \
    rm -rf /usr/local/lib/python3*/ensurepip && \
    groupadd -r -g 10001 kgdbmcp && \
    useradd -r -u 10001 -g kgdbmcp -d /app -s /sbin/nologin kgdbmcp

WORKDIR /app

# Copy virtual environment from builder
COPY --from=builder --chown=kgdbmcp:kgdbmcp /app/.venv /app/.venv

# Copy application source
COPY --from=builder --chown=kgdbmcp:kgdbmcp /app/src /app/src

# Set environment - include UV optimizations for faster startup
ENV PATH="/app/.venv/bin:$PATH" \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH="/app/src"

# Switch to non-root user
USER 10001:10001

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
    CMD ["curl", "-f", "http://localhost:8789/health"]

EXPOSE 8789

# Run the MCP server via the installed console script
CMD ["kidney-genetics-mcp"]
