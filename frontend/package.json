    "reka-ui": "^2.10.4",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.2.1",
    "vee-validate": "^4.15.1",
    "vite-ssg": "^28.3.0",
    "vue": "^3.5.45",
    "vue-router": "^5.5.0",
